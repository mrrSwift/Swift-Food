{
  "name": "Swift-Food",
  "version": "1.1.0",
  "description": "Digital menu for cafe and restaurant",
  "author": "Mr Swift",
  "license": "MIT",
  "homepage": "https://github.com/mrrswift/swift-food",
  "packageManager": "bun@1.2.4",
  "workspaces": [
    "./server",
    "./client"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=restaurant-front",
    "dev:server": "turbo dev --filter=restaurant-menu-api",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "postinstall": "turbo build --filter=shared --filter=server"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "monorepo",
    "turbo"
  ],
  "devDependencies": {
    "bun-types": "latest",
    "turbo": "^2.6.3"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "mongoose": "^9.7.4"
  }
}
